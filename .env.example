# ============================================================
# Sentro Platform Configuration & Automated Alert Emails
# ============================================================

# Toggle Email Alerts (true / false)
ALERT_EMAIL_ENABLED=false

# SMTP Server Settings (Example shown for Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Authentication Credentials
# For Gmail: Use a free 16-character App Password (Google Account > Security > 2-Step Verification > App passwords)
ALERT_EMAIL_SENDER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-16-character-app-password

# Recipient Email for On-Call DevOps Engineers
ALERT_EMAIL_RECIPIENT=devops-alerts@yourdomain.com

# Anomaly Threshold & Throttling
ALERT_SCORE_THRESHOLD=0.70
ALERT_COOLDOWN_SECONDS=300

# Prometheus & Model Paths
PROMETHEUS_URL=http://prometheus:9090
MODEL_DIR=ml/models
POLL_INTERVAL=10
